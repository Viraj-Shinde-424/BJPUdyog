# BJP Udyog Setu - Environment Variables

# Next.js Application
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage Mode: 'local' (file-backed storage with full persistence) or 'supabase'
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/storage

# AI Startup Advisor & Document Verification API
AI_SERVICE_ENABLED=true
# Optional external LLM API key (e.g. Gemini / OpenAI). If unset, the platform uses its robust built-in Maharashtra industrial compliance knowledge base & verification engine.
GEMINI_API_KEY=
OPENAI_API_KEY=

# State Escalation Feature Flag (Default inactive until client confirms roles, stages, triggers & timing)
STATE_ESCALATION_ENABLED=false

# Office-Bearer Badge Style: 'outlined' (default proposed), 'solid', 'accent-bar', or 'pill-fill'
OFFICE_BEARER_BADGE_STYLE=outlined
